@using Pl.Desktop.Models.Features.Plus.Weight.Output

<FluentDataGrid
  TGridItem="PluWeightDto"
  GridTemplateColumns="1fr 3fr"
  Items="Items"
  Pagination="Pagination"
  Class="[&_.col-title-text]:text-left [&_.col-title-text]:pt-1"
  RowClass="@(_ => "!px-3 !h-12 hover:cursor-pointer")"
  OnRowClick="@(row => OnItemSelect.InvokeAsync(row.Item))"
>
  <PropertyColumn
    Property="@(p => p.Number)"
    Title="@WsDataLocalizer["ColPluNumber"]"
  />
  <PropertyColumn
    Property="@(p => p.Name)"
    Title="@WsDataLocalizer["ColName"]"
  />
</FluentDataGrid>

<DataGridPaginationMobile Pagination="Pagination" />

@code {
  [Inject] private IStringLocalizer<WsDataResources> WsDataLocalizer { get; set; } = default!;

  [Parameter] public IQueryable<PluWeightDto> Items { get; set; } = new List<PluWeightDto>().AsQueryable();
  [Parameter] public EventCallback<PluWeightDto> OnItemSelect { get; set; }

  private PaginationState Pagination { get; } = new() { ItemsPerPage = 7 };
}