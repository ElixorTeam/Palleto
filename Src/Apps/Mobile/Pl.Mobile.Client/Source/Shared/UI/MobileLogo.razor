<div @attributes="@Attributes" class="@TwMerge.Merge("shrink-0 flex items-center gap-1.5", Class)">
  <div class="size-9 bg-primary rounded-md overflow-hidden p-1.5">
    <MobileIcon Class="text-background" />
  </div>
  <h2 class="text-2xl tracking-[.25rem]">OBILE</h2>
</div>

@code {
  [Inject] private TwMerge TwMerge { get; set; } = default!;
  [Parameter] public string? Class { get; set; } = string.Empty;
  [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> Attributes { get; set; } = new();
}