@using TscZebra.Plugin.Abstractions.Enums
@implements IDisposable

@attribute [Route($"{Routes.Create}")]

<div class="size-full flex flex-col">
  <PageHeader Title="Формирование паллеты" />
  <div class="size-full max-w-screen-md mx-auto flex flex-col p-6">
    @if (CurrentTabIndex == 1)
    {
      <DocumentStage
        @bind-Value="@DocumentNumber"
        OnSubmitAction="@(() => CurrentTabIndex = 2)"/>
    }
    else if (CurrentTabIndex == 2)
    {
      <PalletsStage
        DocumentNumber="@DocumentNumber"
        OnSubmitAction="@ShowCreateCompleteDialog"
      />
    }
  </div>
</div>

@code {
  [Inject] private IDialogService DialogService { get; set; } = default!;
  [Inject] private IPrinterService PrinterService { get; set; } = default!;

  private int CurrentTabIndex { get; set; } = 1;
  private string DocumentNumber { get; set; } = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await ConnectPrinterAsync();
  }

  private async Task ConnectPrinterAsync()
  {
    PrinterService.Setup(IPAddress.Parse("10.0.22.73"), 9100, PrinterTypes.Zebra);
    await PrinterService.ConnectAsync();
  }

  private Task ShowCreateCompleteDialog() => DialogService.ShowDialogAsync<CompleteCreateDialog>(new());

  public void Dispose() => PrinterService.Disconnect();
}
