    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="9.0.2" />
    <!--Microsoft.Extensions-->
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="9.0.2" />
    <!--Blazor-->
    <PackageVersion Include="BlazorBlueprint.Primitives" Version="3.13.0" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="Phetch.Blazor" Version="1.0.0" />
    <PackageVersion Include="Fluxor.Blazor.Web" Version="6.6.0" />
    <PackageVersion Include="TailwindMerge.NET" Version="1.4.0" />
    <PackageVersion Include="TscZebra.Plugin" Version="1.0.4" />
    <PackageVersion Include="vNext.BlazorComponents.FluentValidation" Version="1.1.3" />
    <!--MAUI-->
    <PackageVersion Include="CommunityToolkit.Maui" Version="11.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.40" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="9.0.40" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.40" />
    <!--Refit-->
    <PackageVersion Include="Refit" Version="8.0.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="8.0.0" />
    <!--Other-->
    <PackageVersion Include="Svg" Version="3.4.7" />
    <PackageVersion Include="Scrutor" Version="6.0.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="BarcodeScanning.Native.Maui" Version="2.1.6" />
    <!--Tests-->
    <PackageVersion Include="bunit" Version="1.38.5" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="FluentAssertions" Version="8.1.1" />
    <PackageVersion Include="Microsoft.Build" Version="17.13.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
