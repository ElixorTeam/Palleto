@using Pl.Admin.Client.Source.Features
@using Pl.Admin.Client.Source.Shared.Extensions
@using Pl.Admin.Client.Source.Shared.Constants

<div class="h-12 px-2 flex items-center w-full shrink-0 transition-colors hover:bg-secondary rounded-md overflow-hidden hover:has-[button:hover]:!bg-inherit" data-sidebar="footer">
  <AuthorizeView Context="authCtx">
    <Authorized>
      <div class="flex w-full items-center overflow-hidden justify-between">
        <div class="flex items-center gap-2 overflow-hidden w-full">
          <div class="flex flex-col w-full pt-1 overflow-hidden">
            <span class="truncate leading-4">@authCtx.User.ShortName()</span>
            <span class="text-sm text-muted-foreground truncate">@($"@{authCtx.User.Identity?.Name}")</span>
          </div>
        </div>
        <form method="post" action="@($"{Routes.Authorization}/logout")" class="shrink-0">
          <PlButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Type="@Components.ButtonType.Submit">
            <span class="sr-only">Logout</span>
            <HeroIcon Name="arrow-left-end-on-rectangle" Class="size-5"/>
          </PlButton>
          <AntiforgeryToken/>
        </form>
      </div>
    </Authorized>
    <NotAuthorized>
      <div class="flex w-full items-center justify-center">
        <PlButton Link="@($"{Routes.Authorization}/login")" Variant="ButtonVariant.Outline">
          Log in
        </PlButton>
      </div>
    </NotAuthorized>
  </AuthorizeView>
  <ThemeSwitcher />
</div>