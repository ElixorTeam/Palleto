@using Pl.Admin.Models.Features.References.ProductionSites
@using Pl.Admin.Models.Features.References.ProductionSites.Queries

@implements IDialogContentComponent<ProductionSiteDto>

@inject IStringLocalizer<ApplicationResources> Localizer

<SectionDialog>
  <Tab Id="@typeof(ProductionSiteUpdateForm).ToString()" Label="@Localizer["SectionProductionSites"]">
    <ProductionSiteUpdateForm Model="Content" FormModel="@ProductionSiteMapper.DtoToUpdateDto(Content)" />
  </Tab>
</SectionDialog>

@code {
  [Parameter] public ProductionSiteDto Content { get; set; } = default!;
}
