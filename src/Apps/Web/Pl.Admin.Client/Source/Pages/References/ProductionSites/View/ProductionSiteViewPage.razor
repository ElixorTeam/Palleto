@using Pl.Admin.Client.Source.Pages.References.ProductionSites.Update
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.References.ProductionSites.Queries
@using Pl.Admin.Models

@attribute [Route(Routes.ProductionSites + "/{Id:guid}")]
@attribute [Authorize(Policy = Policies.Support)]

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject PageHelper PageHelper
@inject RedirectHelper RedirectHelper
@inject ReferencesEndpoints ReferencesEndpoints

<UseEndpoint
  Endpoint="@ReferencesEndpoints.ProductionSiteEndpoint"
  Arg="@Id"
  Context="query"
>
  <BrowserTitle Label="@(query.Data?.Name ?? Localizer["SectionProductionSites"])" />

  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuReferences"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.ProductionSites">@Localizer["SectionProductionSites"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewHeader Title="@query.Data?.Name">
    <ButtonsContent>
      @if (query.HasData)
      {
        <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToProductionSite(query.Data.Id))" />
        <AuthorizeView Policy="@Policies.Admin">
          <ViewButtonUpdate TDialog="ProductionSiteUpdateDialog" Model="query.Data" />
          <ViewButtonDelete Action="@EventCallback.Factory.Create(this, () => DeleteItem(query.Data))" />
        </AuthorizeView>
      }
    </ButtonsContent>

    <TabsContent>
      <ViewTabButton Value="info" @bind-CurrentTab="CurrentTab">
        @Localizer["SectionViewInfo"]
      </ViewTabButton>
    </TabsContent>
  </ViewHeader>

  <Tabs @bind-ActiveTabId="@CurrentTab">
    @if (query.HasData)
    {
      <Tab Id="info">
        <ProductionSiteViewInfo Model="@query.Data"/>
      </Tab>
    }
  </Tabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  private async Task DeleteItem(ProductionSiteDto item)
  {
    await WebApi.DeleteProductionSite(item.Id);
    ReferencesEndpoints.DeleteProductionSite(item.Id);
    await PageHelper.OpenLink(Routes.ProductionSites);
  }
}