@using Pl.Admin.Models.Features.References.ProductionSites.Queries

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer

<ViewFieldGrid Label="@Localizer["FieldCommon"]">
  <ViewFieldGuid Value="@Model.Id" />

  <ViewField
    Label="@WsDataLocalizer["ColName"]"
    Value="@Model.Name"
  />

  <ViewField
    Label="@WsDataLocalizer["ColAddress"]"
    Value="@Model.Address"
  />
</ViewFieldGrid>

@code {
  [Parameter, EditorRequired] public ProductionSiteDto Model { get; set; } = default!;
}