@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.Database

@attribute [Route($"{Routes.Migrations}")]
@attribute [Authorize(Policy = Policies.Developer)]
@rendermode InteractiveServer

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject DiagnosticEndpoints DiagnosticEndpoints

<BrowserTitle Label="@Localizer["SectionMigrations"]" />

<UseParameterlessEndpoint
  Endpoint="@DiagnosticEndpoints.MigrationsEndpoint"
  Context="query"
>
  <Breadcrumbs Class="pb-5">
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuDiagnostics"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["SectionMigrations"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
  </Breadcrumbs>

  <DataGridHeader>
    <DataGridLabelWithCounter
      Label="@Localizer["SectionMigrations"]"
      ItemsCount="@query.Data?.Length"
      IsLoading="query.IsLoading"
    />
    <DataGridActionReload OnClick="@query.RefetchAsync" IsLoading="query.IsFetching"/>
  </DataGridHeader>

  <DataGridContainer
    TItem="MigrationHistoryDto"
    Items="@(query.HasData ? query.Data : [])"
  >
    <ColumnsContent>
      <DataGridColumn
        Caption="@WsDataLocalizer["ColVersion"]"
        Field="@nameof(MigrationHistoryDto.ProductVersion)"
        Width="10%"
      />
      <DataGridColumn
        Caption="@WsDataLocalizer["ColName"]"
        Field="@nameof(MigrationHistoryDto.MigrationId)"
        Width="90%"
      />
    </ColumnsContent>
  </DataGridContainer>
</UseParameterlessEndpoint>

@code {
}
