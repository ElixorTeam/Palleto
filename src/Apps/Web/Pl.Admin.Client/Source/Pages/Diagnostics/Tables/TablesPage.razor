@using BlazorBlueprint.Primitives
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.Database

@attribute [Route($"{Routes.Tables}")]
@attribute [Authorize(Policy = Policies.Developer)]
@rendermode InteractiveServer

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject DiagnosticEndpoints DiagnosticEndpoints

<Breadcrumbs Class="pb-5">
  <PlBreadcrumbItem>
    <PlBreadcrumbPage>@Localizer["MenuDiagnostics"]</PlBreadcrumbPage>
  </PlBreadcrumbItem>
  <PlBreadcrumbItem>
    <PlBreadcrumbPage>@Localizer["SectionTables"]</PlBreadcrumbPage>
  </PlBreadcrumbItem>
</Breadcrumbs>

<UseParameterlessEndpoint
  Endpoint="@DiagnosticEndpoints.TablesEndpoint"
  Context="query"
>
  <DataGridHeader>
    <DataGridLabelWithCounter
      Label="@Localizer["SectionTables"]"
      ItemsCount="@query.Data?.Length"
      IsLoading="query.IsLoading"
    />
    <DataGridActionReload OnClick="@query.RefetchAsync" IsLoading="query.IsFetching"/>
  </DataGridHeader>

  <DataGridContainer
    TItem="DataBaseTableDto"
    Items="@(query.HasData ? query.Data : [])"
    IsFilterable
  >
    <ColumnsContent>
      <DataGridColumn
        Caption="@WsDataLocalizer["ColScheme"]"
        Field="@nameof(DataBaseTableDto.Schema)"
        Width="20%"
        Sortable="false"
        FilterMethod="DataGridColumnFilterMethod.Equals"
        FilterCellClass="!font-normal"
      >
        <FilterTemplate>
          @{ context.SearchValue = Scheme; }
          @if (query.HasData)
          {
            <PlSelect
              TValue="string?"
              @bind-Value="@Scheme"
              @bind-Value:after="@(() => context.TriggerFilterChange(Scheme))"
              Options="@BuildSchemeFilterOptions(query.Data)"
              Placeholder="@Localizer["SelectItemNotSelected"]" />
          }
          else
          {
            <Skeleton Class="h-9 w-full" />
          }
        </FilterTemplate>
      </DataGridColumn>

      <DataGridColumn
        Caption="@WsDataLocalizer["ColName"]"
        Field="@nameof(DataBaseTableDto.Table)"
        Width="30%"
      />

      <DataGridColumn
        Caption="Количество записей"
        Field="@nameof(DataBaseTableDto.Rows)"
        Width="25%"
        Filterable="false"
      />
      <DataGridColumn
        Caption="@($"{WsDataLocalizer["ColSize"]} ({WsDataLocalizer["MeasureMb"]})")"
        Field="@nameof(DataBaseTableDto.UsedMb)"
        Width="25%"
        Filterable="false"
      />
    </ColumnsContent>
  </DataGridContainer>
</UseParameterlessEndpoint>

@code {
  private string? Scheme { get; set; }

  private IList<SelectOption<string?>> BuildSchemeFilterOptions(IEnumerable<DataBaseTableDto> tables) =>
    tables.Select(x => x.Schema).ToHashSet()
      .Select(schema => new SelectOption<string?>(schema, schema))
      .Append(new SelectOption<string?>(null, Localizer["SelectItemNotSelected"]))
      .ToList();
}