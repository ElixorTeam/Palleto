@using Pl.Admin.Client.Source.Pages.PrintSettings.Resources.Update
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.References.TemplateResources.Queries
@using Pl.Admin.Models

@attribute [Route(Routes.Resources + "/{Id:guid}")]
@attribute [Authorize(Policy = Policies.Support)]

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject PageHelper PageHelper
@inject RedirectHelper RedirectHelper
@inject PrintSettingsEndpoints PrintSettingsEndpoints

<UseEndpoint
  Endpoint="@PrintSettingsEndpoints.ResourceEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuPrintSettings"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.Resources">@Localizer["SectionTemplateResources"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Name">
      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToResource(query.Data.Id))" />
          <AuthorizeView Policy="@Policies.Developer">
            <ViewButtonUpdate TDialog="ResourceUpdateDialog" Model="query.Data" />
            <ViewButtonDelete Action="@EventCallback.Factory.Create(this, () => DeleteItem(query.Data))" />
          </AuthorizeView>
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <ResourceViewInfo Model="@query.Data"/>
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  private async Task DeleteItem(TemplateResourceDto item)
  {
    await WebApi.DeleteResource(item.Id);
    PrintSettingsEndpoints.DeleteResource(item.Id);
    await PageHelper.OpenLink(Routes.Resources);
  }
}