@using BlazorBlueprint.Primitives
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Models
@using Pl.Admin.Models.Features.References.TemplateResources.Commands
@using Pl.Admin.Models.Features.References.TemplateResources.Queries
@inherits SectionFormBase<ZplResourceCreateDto>

@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject IStringLocalizer<ApplicationResources> Localizer
@inject PrintSettingsEndpoints PrintSettingsEndpoints
@inject IWebApi WebApi
@inject ZplResourceCreateValidator ZplResourceCreateValidator

<SectionForm
  FormModel="@FormModel"
  Validator="@ZplResourceCreateValidator"
  OnCancelAction="@OnCancelAction"
  OnSubmitAction="@CreateItem"
>
  <FieldsContent>
    <PlFieldInput
      Label="@WsDataLocalizer["ColName"]"
      @bind-Value="@FormModel.Name"
    />

    <PlFieldSelect
      TValue="ZplResourceType"
      @bind-Value="@FormModel.Type"
      Label="@WsDataLocalizer["ColType"]"
      Options="ZplResourceTypes" />

    <PlFieldTextArea
      Class="col-span-2"
      Label="@WsDataLocalizer["ColData"]"
      @bind-Value="@FormModel.Body"
    />
  </FieldsContent>
</SectionForm>

@code {
  private IList<SelectOption<ZplResourceType>> ZplResourceTypes { get; set; } = [];

  protected override void OnInitialized()
  {
    base.OnInitialized();
    ZplResourceTypes = Enum.GetValues(typeof(ZplResourceType))
      .Cast<ZplResourceType>()
      .Select(item => new SelectOption<ZplResourceType>(item, Localizer[item.GetDescription()]))
      .ToList();
  }

  protected override async Task CreateItemAction(ZplResourceCreateDto item)
  {
    TemplateResourceDto dto = await WebApi.CreateResource(item);
    PrintSettingsEndpoints.AddResource(dto, item.Body);
  }
}
