@using Pl.Admin.Models.Features.References.TemplateResources
@using Pl.Admin.Models.Features.References.TemplateResources.Queries

@implements IDialogContentComponent<TemplateResourceDto>

@inject IStringLocalizer<ApplicationResources> Localizer

<SectionDialog>
  <Tab Id="@typeof(ResourceUpdateForm).ToString()" Label="@Localizer["SectionTemplateResources"]">
    <ResourceUpdateForm Model="Content" FormModel="@TemplateResourceMapper.DtoToUpdateDto(Content)" />
  </Tab>
</SectionDialog>

@code {
  [Parameter] public TemplateResourceDto Content { get; set; } = default!;
}
