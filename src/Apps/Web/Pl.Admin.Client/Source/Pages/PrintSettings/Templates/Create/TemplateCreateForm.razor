@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Models
@using Pl.Admin.Models.Features.References.Template.Commands
@using Pl.Admin.Models.Features.References.Template.Queries
@inherits SectionFormBase<TemplateCreateDto>

@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject PrintSettingsEndpoints PrintSettingsEndpoints
@inject IWebApi WebApi
@inject TemplateCreateValidator TemplateCreateValidator

<SectionForm
  FormModel="@FormModel"
  Validator="@TemplateCreateValidator"
  OnCancelAction="@OnCancelAction"
  OnSubmitAction="@CreateItem"
>
  <FieldsContent>

    <SectionTextField
      Label="@WsDataLocalizer["ColName"]"
      @bind-Value="@FormModel.Name"
      For="@(() => FormModel.Name)"
    />

    <PlFieldSelect
      @bind-Value="@FormModel.IsWeight"
      Label="@WsDataLocalizer["ColType"]"
      ItemDisplayName='i => WsDataLocalizer[i ? "ColTemplateWeight" : "ColTemplatePiece"]'>
      <PlSelectItem Value="true" Text="@WsDataLocalizer["ColTemplateWeight"]" />
      <PlSelectItem Value="false" Text="@WsDataLocalizer["ColTemplatePiece"]" />
    </PlFieldSelect>

    <FormDivider>@WsDataLocalizer["ColSize"]</FormDivider>

    <PlFieldInputNumber
      @bind-Value="@FormModel.Width"
      Label="@($"{WsDataLocalizer["ColWidth"]} ({WsDataLocalizer["MeasureMm"]})")"
      Min="1"
      Max="512"
    />

    <PlFieldInputNumber
      @bind-Value="@FormModel.Height"
      Label="@($"{WsDataLocalizer["ColHeight"]} ({WsDataLocalizer["MeasureMm"]})")"
      Min="1"
      Max="512"
    />

    <PlFieldSelect
      @bind-Value="@FormModel.Rotate"
      Label="@($"{WsDataLocalizer["ColRotation"]} (°)")">
      <PlSelectItem Value="@((short)0)" Text="0" />
      <PlSelectItem Value="@((short)90)" Text="90" />
    </PlFieldSelect>

    <FormDivider>@WsDataLocalizer["ColTemplate"]</FormDivider>

    <SectionTextAreaField
      Label="@WsDataLocalizer["ColTemplate"]"
      @bind-Value="@FormModel.Body"
    />
  </FieldsContent>
</SectionForm>

@code {
  protected override async Task CreateItemAction(TemplateCreateDto item)
  {
    TemplateDto dto = await WebApi.CreateTemplate(item);
    PrintSettingsEndpoints.AddTemplate(dto, FormModel.Body);
  }
}
