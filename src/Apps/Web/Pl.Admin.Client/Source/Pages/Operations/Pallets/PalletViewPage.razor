@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants

@attribute [Route(Routes.Pallets + "/{Id:guid}")]

@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject IStringLocalizer<ApplicationResources> Localizer
@inject OperationsEndpoints OperationsEndpoints
@inject RedirectHelper RedirectHelper

<UseEndpoint
  Endpoint="@OperationsEndpoints.PalletEndpoint"
  Arg="@Id"
  Context="query"
>
  <BrowserTitle Label="@WsDataLocalizer["ColPallet"]" />

  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuOperations"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@(WsDataLocalizer["ColPallet"] + " №" + query.Data.Number)</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewHeader Title="@(query.HasData ? WsDataLocalizer["ColPallet"] + " №" + query.Data.Number : string.Empty)">
    <ButtonsContent>
      @if (query.HasData)
      {
        <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToPallet(query.Data.Id))" />
      }
    </ButtonsContent>

    <TabsContent>
      <ViewTabButton Value="info" @bind-CurrentTab="CurrentTab">
        @Localizer["SectionViewInfo"]
      </ViewTabButton>
      <ViewTabButton Value="labels" @bind-CurrentTab="CurrentTab">
        @WsDataLocalizer["ColLabels"]
      </ViewTabButton>
    </TabsContent>
  </ViewHeader>
  <Tabs @bind-ActiveTabId="@CurrentTab">
    @if (query.HasData)
    {
      <Tab Id="info">
        <PalletViewInfo Model="query.Data"/>
      </Tab>
      <Tab Id="labels">
        <PalletViewLabels Model="query.Data"/>
      </Tab>
    }
  </Tabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";
}