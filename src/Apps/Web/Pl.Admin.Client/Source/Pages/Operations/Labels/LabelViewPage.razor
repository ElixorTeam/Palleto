@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants

@attribute [Route(Routes.Labels + "/{Id:guid}")]

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject OperationsEndpoints OperationsEndpoints
@inject RedirectHelper RedirectHelper

<UseEndpoint
  Endpoint="@OperationsEndpoints.LabelEndpoint"
  Arg="@Id"
  Context="query"
>
  <BrowserTitle Label="@WsDataLocalizer["ColLabel"]" />

  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuOperations"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@(WsDataLocalizer["ColLabel"] + " №" + query.Data.Id)</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewHeader Title="@(query.HasData ? WsDataLocalizer["ColLabel"] + " №" + query.Data.Id : string.Empty)">
    <ButtonsContent>
      @if (query.HasData)
      {
        <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToLabel(query.Data.Id))" />
      }
    </ButtonsContent>
    <TabsContent>
      <ViewTabButton Value="info" @bind-CurrentTab="CurrentTab">
        @Localizer["SectionViewInfo"]
      </ViewTabButton>
      <ViewTabButton Value="preview" @bind-CurrentTab="CurrentTab">
        @Localizer["SectionViewPreview"]
      </ViewTabButton>
    </TabsContent>
  </ViewHeader>

  <Tabs @bind-ActiveTabId="@CurrentTab">
    @if (query.HasData)
    {
      <Tab Id="info">
        <LabelViewInfo Model="query.Data"/>
      </Tab>
      <Tab Id="preview">
        <LabelViewPreview Model="query.Data"/>
      </Tab>
    }
  </Tabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";
}
