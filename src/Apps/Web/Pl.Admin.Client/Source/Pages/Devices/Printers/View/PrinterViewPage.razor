@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.Devices.Printers.Queries
@using Pl.Admin.Models
@using Pl.Admin.Client.Source.Pages.Devices.Printers.Update
@using Pl.Admin.Client.Source.Features

@attribute [Route(Routes.Printers + "/{Id:guid}")]
@attribute [Authorize(Policy = Policies.Support)]

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject PageHelper PageHelper
@inject DevicesEndpoints DevicesEndpoints
@inject RedirectHelper RedirectHelper

<UseEndpoint
  Endpoint="@DevicesEndpoints.PrinterEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuDevices"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.Printers">@Localizer["SectionPrinters"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Name">
      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToPrinter(query.Data.Id))" />
          <SupportAuthView ProductionSiteUid="@query.Data.ProductionSite.Id">
            <ViewButtonUpdate TDialog="PrinterUpdateDialog" Model="query.Data" />
          </SupportAuthView>
          <AuthorizeView Policy="@Policies.SeniorSupport">
            <ViewButtonDelete Action="@EventCallback.Factory.Create(this, () => DeleteItem(query.Data))" />
          </AuthorizeView>
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="control" Label="@Localizer["SectionViewControl"]">
            @Localizer["SectionViewControl"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <PrinterViewInfo Model="@query.Data"/>
      </PlTabsContent>
      <PlTabsContent Value="control">
        <PrinterViewControl Model="@query.Data" />
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  protected override void OnInitialized()
  {
    base.OnInitialized();
    CurrentTab = PageHelper.GetUrlQueryParam("tab") ?? "info";
  }

  private async Task DeleteItem(PrinterDto item)
  {
    await WebApi.DeletePrinter(item.Id);
    DevicesEndpoints.DeletePrinter(item.ProductionSite.Id, item.Id);
    await PageHelper.OpenLink(Routes.Printers);
  }
}
