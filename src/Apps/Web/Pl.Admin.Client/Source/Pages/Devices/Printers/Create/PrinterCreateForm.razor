@using BlazorBlueprint.Primitives
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using TscZebra.Plugin.Abstractions.Enums
@using Pl.Admin.Models
@using Pl.Admin.Models.Features.Devices.Printers.Commands
@using Pl.Admin.Models.Features.Devices.Printers.Queries

@inherits SectionFormBase<PrinterCreateDto>

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject DevicesEndpoints DevicesEndpoints
@inject PrinterCreateValidator PrinterCreateValidator

<SectionForm
  FormModel="@FormModel"
  Validator="@PrinterCreateValidator"
  OnCancelAction="@OnCancelAction"
  OnSubmitAction="@CreateItem"
>
  <FieldsContent>
    <PlFieldInput
      Label="@WsDataLocalizer["ColName"]"
      @bind-Value="@FormModel.Name"
    />
    @* MaxLength="16" *@

    <PlFieldInputIp
      Label="@WsDataLocalizer["ColIp"]"
      @bind-Value="@FormModel.Ip"
    />

    <PlFieldSelect
      TValue="PrinterTypes"
      @bind-Value="@FormModel.Type"
      Label="@WsDataLocalizer["ColManufacturer"]"
      Options="PrinterTypeOptions" />
  </FieldsContent>
</SectionForm>

@code {
  private IList<SelectOption<PrinterTypes>> PrinterTypeOptions { get; set; } = [];

  protected override void OnInitialized()
  {
    base.OnInitialized();
    PrinterTypeOptions = Enum.GetValues(typeof(PrinterTypes))
      .Cast<PrinterTypes>()
      .Select(item => new SelectOption<PrinterTypes>(item, Localizer[item.GetDescription()]))
      .ToList();
  }

  protected override async Task CreateItemAction(PrinterCreateDto item)
  {
    PrinterDto dto = await WebApi.CreatePrinter(item);
    DevicesEndpoints.AddPrinter(FormModel.ProductionSiteId, dto);
  }
}
