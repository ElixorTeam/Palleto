@using Pl.Admin.Models.Features.Devices.Printers.Queries

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject RedirectHelper RedirectHelper

<ViewFieldGrid Label="@Localizer["FieldCommon"]">
  <ViewFieldGuid Value="@Model.Id" />

  <ViewField
    Label="@WsDataLocalizer["ColName"]"
    Value="@Model.Name"
  />

  <ViewField
    Label="IP"
    Value="@Model.Ip.ToString()"
  />

  <ViewField
    Label="@WsDataLocalizer["ColType"]"
    Value="@Model.Type.ToString()"
  />

  <ViewField
    Label="@WsDataLocalizer["ColProductionSite"]"
    Value="@Model.ProductionSite.Name"
    Link="@RedirectHelper.ToProductionSite(Model.ProductionSite.Id)"
  />
</ViewFieldGrid>

@code {
  [Parameter, EditorRequired] public PrinterDto Model { get; set; } = default!;
}