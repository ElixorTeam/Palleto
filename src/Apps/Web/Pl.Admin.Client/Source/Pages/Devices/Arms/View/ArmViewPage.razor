@using Pl.Admin.Client.Source.Pages.Devices.Arms.Update
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.Devices.Arms.Queries
@using Pl.Admin.Models
@using Pl.Admin.Client.Source.Features

@attribute [Route(Routes.Arms + "/{Id:guid}")]
@attribute [Authorize(Policy = Policies.Support)]

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject PageHelper PageHelper
@inject DevicesEndpoints DevicesEndpoints
@inject RedirectHelper RedirectHelper

<UseEndpoint
  Endpoint="@DevicesEndpoints.ArmEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuDevices"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.Arms">@Localizer["SectionArm"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Name">
      <TitleContent Context="header">
        <div class="flex gap-2 items-center">
          <h2 class="font-bold text-3xl truncate tracking-tight">@header</h2>
          @if (query.HasData)
          {
            <div class="@Css.Class("size-4 rounded-full overflow-hidden", (DateTime.Now - query.Data.ChangeDt).TotalMinutes < 5 ? "bg-green-500" : "bg-muted-foreground")"></div>
          }
        </div>
      </TitleContent>

      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToArm(query.Data.Id))" />
          <SupportAuthView ProductionSiteUid="@query.Data.ProductionSite.Id">
            <ViewButtonUpdate TDialog="ArmUpdateDialog" Model="query.Data" />
          </SupportAuthView>
          <AuthorizeView Policy="@Policies.SeniorSupport">
            <ViewButtonDelete Action="@EventCallback.Factory.Create(this, () => DeleteItem(query.Data))" />
          </AuthorizeView>
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="plus" Label="@WsDataLocalizer["ColPlu"]">
            @WsDataLocalizer["ColPlu"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="labels" Label="@WsDataLocalizer["ColLabels"]">
            @WsDataLocalizer["ColLabels"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="pallets" Label="@WsDataLocalizer["ColPallets"]">
            @WsDataLocalizer["ColPallets"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="analytics" Label="@Localizer["SectionViewAnalytics"]">
            @Localizer["SectionViewAnalytics"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <ArmViewInfo Model="@query.Data"/>
      </PlTabsContent>
      <PlTabsContent Value="analytics">
        <ArmViewAnalytics Model="@query.Data" />
      </PlTabsContent>
      <PlTabsContent Value="labels">
        <ArmViewLabels Model="@query.Data" />
      </PlTabsContent>
      <PlTabsContent Value="pallets">
        <ArmViewPallets Model="@query.Data" />
      </PlTabsContent>
      <PlTabsContent Value="plus">
        <ArmViewPlu Model="@query.Data" />
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  protected override void OnInitialized()
  {
    base.OnInitialized();
    CurrentTab = PageHelper.GetUrlQueryParam("tab") ?? "info";
  }

  private async Task DeleteItem(ArmDto item)
  {
    await WebApi.DeleteArm(item.Id);
    DevicesEndpoints.DeleteArm(item.ProductionSite.Id, item.Id);
    await PageHelper.OpenLink(Routes.Arms);
  }
}
