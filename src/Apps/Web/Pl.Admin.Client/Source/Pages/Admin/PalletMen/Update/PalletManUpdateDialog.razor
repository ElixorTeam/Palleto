@using Pl.Admin.Models.Features.Admins.PalletMen
@using Pl.Admin.Models.Features.Admins.PalletMen.Queries

@implements IDialogContentComponent<PalletManDto>

@inject IStringLocalizer<ApplicationResources> Localizer

<SectionDialog>
  <SectionDialogTab Id="@typeof(PalletManUpdateForm).ToString()" Label="@Localizer["SectionPalletMen"]">
    <PalletManUpdateForm Model="Content" FormModel="@PalletManMapper.DtoToUpdateDto(Content)" />
  </SectionDialogTab>
</SectionDialog>

@code {
  [Parameter] public PalletManDto Content { get; set; } = default!;
}
