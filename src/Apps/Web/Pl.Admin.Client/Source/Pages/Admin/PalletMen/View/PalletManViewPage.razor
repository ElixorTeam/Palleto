@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants
@using Pl.Admin.Models.Features.Admins.PalletMen.Queries
@using Pl.Admin.Models
@using Pl.Admin.Client.Source.Pages.Admin.PalletMen.Update
@using Pl.Admin.Client.Source.Features

@attribute [Route(Routes.PalletMen + "/{Id:guid}")]

@inject IWebApi WebApi
@inject IStringLocalizer<ApplicationResources> Localizer
@inject PageHelper PageHelper
@inject AdminEndpoints AdminEndpoints
@inject RedirectHelper RedirectHelper

<UseEndpoint
  Endpoint="@AdminEndpoints.PalletManEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["MenuAdministration"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.PalletMen">@Localizer["SectionPalletMen"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Fio.DisplayShortName</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Fio.DisplayShortName">
      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToPalletMan(query.Data.Id))" />

          <SupportAuthView ProductionSiteUid="@query.Data.ProductionSite.Id">
            <ViewButtonUpdate TDialog="PalletManUpdateDialog" Model="query.Data" />
          </SupportAuthView>

          <AuthorizeView Policy="@Policies.SeniorSupport">
            <ViewButtonDelete Action="@EventCallback.Factory.Create(this, () => DeleteItem(query.Data))" />
          </AuthorizeView>
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <PalletManViewInfo Model="@query.Data"/>
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  private async Task DeleteItem(PalletManDto item)
  {
    await WebApi.DeletePalletMan(item.Id);
    AdminEndpoints.DeletePalletMan(item.ProductionSite.Id, item.Id);
    await PageHelper.OpenLink(Routes.PalletMen);
  }
}
