@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants

@attribute [Route(Routes.Brands + "/{Id:guid}")]

@inject IStringLocalizer<ApplicationResources> Localizer
@inject RedirectHelper RedirectHelper
@inject References1CEndpoints References1CEndpoints

<UseEndpoint
  Endpoint="@References1CEndpoints.BrandEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["Menu1CReferences"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.Brands">@Localizer["SectionBrands"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Name">

      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToBrand(query.Data.Id))" />
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <BrandViewInfo Model="@query.Data" />
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";
}