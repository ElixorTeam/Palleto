@using Pl.Admin.Client.Source.Pages.References1C.Plus.Update
@using Pl.Admin.Client.Source.Shared.Api.Web.Endpoints
@using Pl.Admin.Client.Source.Shared.Constants

@attribute [Route(Routes.Plus + "/{Id:guid}")]

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IStringLocalizer<WsDataResources> WsDataLocalizer
@inject References1CEndpoints References1CEndpoints
@inject RedirectHelper RedirectHelper
@inject PageHelper PageHelper

<UseEndpoint
  Endpoint="@References1CEndpoints.PluEndpoint"
  Arg="@Id"
  Context="query"
>
  <Breadcrumbs>
    <PlBreadcrumbItem>
      <PlBreadcrumbPage>@Localizer["Menu1CReferences"]</PlBreadcrumbPage>
    </PlBreadcrumbItem>
    <PlBreadcrumbItem>
      <PlBreadcrumbLink Href="@Routes.Plus">@Localizer["SectionPlu"]</PlBreadcrumbLink>
    </PlBreadcrumbItem>
    @if (query.HasData)
    {
      <PlBreadcrumbItem>
        <PlBreadcrumbPage>@query.Data.Name</PlBreadcrumbPage>
      </PlBreadcrumbItem>
    }
  </Breadcrumbs>

  <ViewTabs @bind-CurrentTab="CurrentTab">
    <ViewHeader Title="@query.Data?.Name">
      <ButtonsContent>
        @if (query.HasData)
        {
          <ViewButtonShare Link="@RedirectHelper.ToAbsoluteUrl(RedirectHelper.ToPlu(query.Data.Id))" />
          <AuthorizeView Policy="@Policies.Support">
            <ViewButtonUpdate TDialog="PluUpdateDialog" Model="query.Data" />
          </AuthorizeView>
        }
      </ButtonsContent>

      <TabsContent>
        <ViewTabsList>
          <ViewTabTrigger Value="info" Label="@Localizer["SectionViewInfo"]">
            @Localizer["SectionViewInfo"]
          </ViewTabTrigger>
          <ViewTabTrigger Value="characteristics" Label="@WsDataLocalizer["ColCharacteristics"]">
            @WsDataLocalizer["ColCharacteristics"]
          </ViewTabTrigger>
        </ViewTabsList>
      </TabsContent>
    </ViewHeader>

    @if (query.HasData)
    {
      <PlTabsContent Value="info">
        <PluViewInfo Model="@query.Data"/>
      </PlTabsContent>
      <PlTabsContent Value="characteristics">
        <PluViewCharacteristics Model="@query.Data" />
      </PlTabsContent>
    }
  </ViewTabs>
</UseEndpoint>

@code {
  [Parameter] public Guid Id { get; set; }

  private string CurrentTab { get; set; } = "info";

  protected override void OnInitialized()
  {
    base.OnInitialized();
    CurrentTab = PageHelper.GetUrlQueryParam("tab") ?? "info";
  }
}