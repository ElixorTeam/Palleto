@rendermode InteractiveServer

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IJSRuntime JsRuntime

<PlDropdown>
  <PlDropdownTrigger>
    <PlButton
      Variant="ButtonVariant.Ghost"
      Size="ButtonSize.Icon"
      Class="shrink-0">
      <HeroIcon Name="sun" Class="size-5 dark:hidden"/>
      <HeroIcon Name="moon" Class="size-5 hidden dark:block"/>
      <span class="sr-only">Toggle theme</span>
    </PlButton>
  </PlDropdownTrigger>
  <PlDropdownContent>
    <PlDropdownLabel>Theme</PlDropdownLabel>
    <PlDropdownSeparator/>
    <PlDropdownItem OnClick="@(() => SetTheme("light"))">
      <Icon><HeroIcon Name="sun" /></Icon>
      <ChildContent>@Localizer[ThemeType.Light.GetDescription()]</ChildContent>
    </PlDropdownItem>
    <PlDropdownItem OnClick="@(() => SetTheme("dark"))">
      <Icon><HeroIcon Name="moon" /></Icon>
      <ChildContent>@Localizer[ThemeType.Dark.GetDescription()]</ChildContent>
    </PlDropdownItem>
    <PlDropdownItem OnClick="@(() => SetTheme("system"))">
      <Icon><HeroIcon Name="computer-desktop" /></Icon>
      <ChildContent>@Localizer[ThemeType.System.GetDescription()]</ChildContent>
    </PlDropdownItem>
  </PlDropdownContent>
</PlDropdown>

@code {
  private async Task SetTheme(string theme) => await JsRuntime.InvokeVoidAsync("switchTheme", theme);
}
