@inject IStringLocalizer<ApplicationResources> Localizer

<div class="col-span-6 flex w-full h-10 items-center justify-center">
  @if (string.IsNullOrWhiteSpace(Placeholder))
  {
    <span>@Localizer["BarcodeEditorEmptyPlaceholder"]</span>
  }
  else
  {
    <span>Placeholder</span>
  }
</div>

@code {
  [Parameter] public string Placeholder { get; set; } = default!;
}