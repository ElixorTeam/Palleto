@using Pl.Components.Components
@using ButtonType=Pl.Components.Components.ButtonType

<Router AppAssembly="typeof(Program).Assembly">
  <Found Context="routeData">
    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
      <NotAuthorized>
        <div class="size-full flex flex-col grow items-center justify-center">
          @if (context.User.Identity?.IsAuthenticated != true)
          {
          <h3 class="text-lg">You are not authorized</h3>
          <form method="get" action="@($"{Shared.Constants.Routes.Authorization}/login")">
            <PlButton class="w-64 mt-4" Type="ButtonType.Submit">
              Log in
            </PlButton>
            <AntiforgeryToken />
          </form>
          }
          else
          {
            <h3 class="text-lg">You don't have enough right</h3>
            <PlButton Link="@Shared.Constants.Routes.Home" class="w-64 mt-4">
              Go home
            </PlButton>
          }
        </div>
      </NotAuthorized>
    </AuthorizeRouteView>
    @* <FocusOnNavigate RouteData="routeData" Selector="h1" /> *@
  </Found>
</Router>