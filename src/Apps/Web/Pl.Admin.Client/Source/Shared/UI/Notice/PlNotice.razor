@inject TwMerge TwMerge

<div
  role="alert"
  class="@TwMerge.Merge("rounded-lg border px-4 py-3", Variant.ContainerCss(), Class)"
>
  <div class="flex items-start gap-3">
    <div class="@TwMerge.Merge("flex size-9 shrink-0 items-center justify-center rounded-md border [&_svg]:size-[1.125rem]", Variant.IconContainerCss())">
      @if (Icon is not null)
      {
        @Icon
      }
      else
      {
        <HeroIcon Name="@Variant.DefaultIconName()" />
      }
    </div>

    <div class="min-w-0 flex-1 space-y-1">
      @if (!string.IsNullOrEmpty(Title))
      {
        <p class="font-medium leading-none text-foreground">@Title</p>
      }

      @if (!string.IsNullOrEmpty(Description))
      {
        <p class="text-sm text-muted-foreground">@Description</p>
      }

      @if (ChildContent is not null)
      {
        <div class="@(string.IsNullOrEmpty(Description) ? null : "pt-0.5")">
          @ChildContent
        </div>
      }
    </div>
  </div>
</div>

@code {
  [Parameter] public NoticeVariant Variant { get; set; } = NoticeVariant.Warning;

  [Parameter] public string? Title { get; set; }

  [Parameter] public string? Description { get; set; }

  [Parameter] public RenderFragment? Icon { get; set; }

  [Parameter] public RenderFragment? ChildContent { get; set; }

  [Parameter] public string? Class { get; set; }
}
