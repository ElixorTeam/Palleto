<AuthorizeView Policy="@Policies.Admin">
  <CopyableField Value="@Value.ToString()">
    <PlFieldInput Label="@Label" Value="@Value.ToString().ToUpper()" Disabled />
  </CopyableField>
</AuthorizeView>

@code {
  [Parameter] public Guid Value { get; set; }
  [Parameter] public string Label { get; set; } = "ID";
}
