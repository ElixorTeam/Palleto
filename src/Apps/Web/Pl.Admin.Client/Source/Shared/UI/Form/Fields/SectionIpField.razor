@inherits SectionFieldBase<IPAddress>

<SectionInputWrapper
  ValueToCopy="@(IsCopyable ? Value?.ToString() : string.Empty)"
>
  <PlFieldInputIp
    Value="@EffectiveValue"
    ValueChanged="@HandleValueChanged"
    ValueExpression="@ValueExpression"
    Label="@Label"
    Placeholder="@Placeholder"
    Disabled="@Disabled" />
</SectionInputWrapper>

@code {
  private IPAddress EffectiveValue => Value ?? IPAddress.None;

  private async Task HandleValueChanged(IPAddress value)
  {
    Value = value;
    await ValueChanged.InvokeAsync(value);
  }
}
