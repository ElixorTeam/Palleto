@inherits SectionFieldBase<string>

<SectionInputWrapper
  ValueToCopy="@(IsCopyable ? ValueToCopy ?? Value : string.Empty)"
  Size="SectionInputSize.Large"
>
  <PlFieldTextArea
    Value="@Value"
    ValueChanged="@ValueChanged"
    ValueExpression="@ValueExpression"
    Label="@Label"
    Placeholder="@Placeholder"
    Disabled="@Disabled" />
</SectionInputWrapper>
