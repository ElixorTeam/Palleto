@inherits SectionFieldBase<string>

<SectionInputWrapper ValueToCopy="@(IsCopyable ? ValueToCopy ?? Value : string.Empty)">
  <PlFieldInput
    Value="@Value"
    ValueChanged="@ValueChanged"
    ValueExpression="@ValueExpression"
    Label="@Label"
    Placeholder="@Placeholder"
    Disabled="@Disabled"
   />
</SectionInputWrapper>

@code {
@*   maxlength="@(MaxLength <= 0 ? string.Empty : MaxLength)" *@
  [Parameter] public short MaxLength { get; set; }
}