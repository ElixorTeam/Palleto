@inherits SectionFieldBase<Guid>

<SectionInputWrapper
  ValueToCopy="@(IsCopyable ? Value.ToString() : string.Empty)"
>
  <PlFieldInputGuid
    Value="@Value"
    ValueChanged="@ValueChanged"
    ValueExpression="@ValueExpression"
    Label="@Label"
    Placeholder="@Placeholder"
    Disabled="@Disabled" />
</SectionInputWrapper>
