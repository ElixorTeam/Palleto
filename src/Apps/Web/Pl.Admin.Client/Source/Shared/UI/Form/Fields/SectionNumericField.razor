@typeparam TItem where TItem : struct, System.Numerics.INumber<TItem>
@inherits SectionFieldBase<TItem>

<SectionInputWrapper>
  <PlFieldInputNumber
    Label="@Label"
    Value="@Value"
    ValueChanged="@ValueChanged"
    ValueExpression="@ValueExpression"
    Placeholder="@Placeholder"
    Disabled="@Disabled"
    Step="@Step"
  />
</SectionInputWrapper>

@code {
  [Parameter] public TItem? Min { get; set; }
  [Parameter] public TItem? Max { get; set; }
  [Parameter] public TItem? Step { get; set; }
}