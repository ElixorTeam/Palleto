@typeparam TDialog where TDialog: IDialogContentComponent

@inject IStringLocalizer<ApplicationResources> Localizer
@inject IDialogService DialogService
@inject PageHelper PageHelper

<PlButton Variant="ButtonVariant.Outline" OnClick="@OpenUpdateDialog">
  <HeroIcon Name="pencil" Class="size-4 mr-2"/>
  <span class="sr-only sm:!not-sr-only">@Localizer["BtnUpdate"]</span>
</PlButton>

@code {
  [Parameter, EditorRequired] public object Model { get; set; } = default!;

  private Task OpenUpdateDialog() => DialogService.ShowDialogAsync<TDialog>(Model, PageHelper.DialogParameters);
}
