@inject IStringLocalizer<ApplicationResources> Localizer
@inject IDialogService DialogService
@inject PageHelper PageHelper

<PlButton Variant="ButtonVariant.Outline" OnClick="@OpenShareDialog">
  <HeroIcon Name="share" Class="size-4 mr-2"/>
  <span class="sr-only sm:!not-sr-only">@Localizer["BtnShare"]</span>
</PlButton>

@code {
  [Parameter, EditorRequired] public string Link { get; set; } = string.Empty;

  private Task OpenShareDialog() => DialogService.ShowDialogAsync<ShareUrlDialog>(Link, PageHelper.DialogParameters);
}
