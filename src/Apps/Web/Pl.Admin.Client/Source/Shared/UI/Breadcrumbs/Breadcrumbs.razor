@inject TwMerge TwMerge

<PlBreadcrumb Class="@TwMerge.Merge(Class)">
  <PlBreadcrumbList AutoSeparator>
    <SeparatorContent>
      <HeroIcon Name="chevron-right" Class="size-3"/>
    </SeparatorContent>
    <ChildContent>
      @ChildContent
    </ChildContent>
  </PlBreadcrumbList>
</PlBreadcrumb>

@code {
  [Parameter] public string Class { get; set; } = string.Empty;
  [Parameter] public RenderFragment? ChildContent { get; set; }
}