@inject IStringLocalizer<ApplicationResources> Localizer

<PlButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="@OnClick" Disabled="@IsLoading">
  <HeroIcon Name="plus" Class="size-4 sm:mr-2"/>
  <span class="sr-only sm:!not-sr-only">@Localizer["BtnAdd"]</span>
</PlButton>

@code {
  [Parameter] public EventCallback OnClick { get; set; }
  [Parameter] public bool IsLoading { get; set; }
}
