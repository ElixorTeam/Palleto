<Dialog Class="max-w-screen-lg min-h-52 p-0">
  <PlTabs @bind-Value="_activeTab" Class="w-full">
  <CascadingValue Value="this" IsFixed="true">
    @if (_tabs.Count > 0)
    {
      <DialogHeader>
        @if (_tabs.Count > 1)
        {
          <PlTabsList>
            @foreach (SectionDialogTab tab in _tabs)
            {
              <PlTabsTrigger Value="@tab.Id" Label="@tab.Label">
                @tab.Label
              </PlTabsTrigger>
            }
          </PlTabsList>
        }
        else
        {
          <span class="truncate text-base font-semibold tracking-tight text-foreground">
            @_tabs[0].Label
          </span>
        }
      </DialogHeader>
    }

    <div class="p-6">
      @ChildContent
    </div>
  </CascadingValue>
  </PlTabs>
</Dialog>

@code {
  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  [Parameter]
  public string? DefaultTab { get; set; }

  private string? _activeTab;
  private readonly List<SectionDialogTab> _tabs = [];

  internal void RegisterTab(SectionDialogTab tab)
  {
    if (_tabs.Contains(tab))
      return;

    _tabs.Add(tab);

    if (string.IsNullOrEmpty(_activeTab))
      _activeTab = DefaultTab ?? tab.Id;

    StateHasChanged();
  }

  internal void UnregisterTab(SectionDialogTab tab)
  {
    if (!_tabs.Remove(tab))
      return;

    StateHasChanged();
  }
}
