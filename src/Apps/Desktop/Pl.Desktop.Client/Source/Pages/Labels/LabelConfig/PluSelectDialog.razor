@using Pl.Components.Components
<Dialog Class="max-w-screen-md select-none">
  <DialogHeader>
    <PlButton
      Variant="ButtonVariant.Secondary"
      Class="disabled:!opacity-100"
      Disabled
    >
      @Localizer["PluSelectHeader"]
    </PlButton>
  </DialogHeader>
  <PluDataGrid
    Items="Content.Data"
    OnItemSelect="@(item => Dialog.CloseAsync(item))"
  />
</Dialog>
