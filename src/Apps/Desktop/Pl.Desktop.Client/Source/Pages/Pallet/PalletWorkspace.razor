@using Pl.Desktop.Client.Source.Pages.Pallet.PalletOverview
@using Pl.Desktop.Models.Features.Pallets.Output

<div class="size-full flex flex-col overflow-hidden">
  <PlTabs
    Value="@ActiveTabId"
    ValueChanged="ChangeActiveId"
    Class="size-full flex flex-col overflow-hidden">
    <div class="h-14 shrink-0 bg-background w-full grid grid-cols-4 border-b px-4">
      <div class="flex h-full items-center">
        <PlButton
          Size="ButtonSize.Icon"
          Variant="ButtonVariant.Ghost"
          OnClick="@CloseCurrentPallet">
          <HeroIcon Name="arrow-left" Class="size-5 text-muted-foreground" />
        </PlButton>
      </div>
      <div class="h-full flex items-center justify-center w-full col-span-2 grow overflow-hidden">
        <PlTabsList Class="h-auto bg-transparent p-0 gap-2">
          <PlTabsTrigger Value="@PalletViewTabType.Info.ToString()" Label="@WsDataLocalizer["ColPallet"]">
            @WsDataLocalizer["ColPallet"]
          </PlTabsTrigger>
          <PlTabsTrigger Value="@PalletViewTabType.Labels.ToString()" Label="@Localizer["ColPrint"]">
            @Localizer["ColPrint"]
          </PlTabsTrigger>
        </PlTabsList>
      </div>
    </div>
    <div class="size-full bg-secondary/[.3] flex flex-col grow overflow-hidden">
      <PlTabsContent Value="@PalletViewTabType.Info.ToString()">
        <PalletOverview Pallet="Pallet" />
      </PlTabsContent>
      <PlTabsContent Value="@PalletViewTabType.Labels.ToString()">
        <LabelsGrid Pallet="Pallet" />
      </PlTabsContent>
    </div>
  </PlTabs>
</div>

@code {
  # region Injects

  [Inject] private IStringLocalizer<WsDataResources> WsDataLocalizer { get; set; } = default!;
  [Inject] private IStringLocalizer<ApplicationResources> Localizer { get; set; } = default!;
  [Inject] private IDispatcher Dispatcher { get; set; } = default!;
  [Inject] private IState<PalletState> PalletState { get; set; } = default!;

  # endregion

  [Parameter, EditorRequired] public PalletDto Pallet { get; set; } = null!;

  private string ActiveTabId => PalletState.Value.PalletViewTabType.ToString();

  private void ChangeActiveId(string? newActiveId)
  {
    if (string.IsNullOrEmpty(newActiveId))
      return;

    if (Enum.TryParse(newActiveId, out PalletViewTabType newViewTab))
      Dispatcher.Dispatch(new ChangePalletViewTabAction(newViewTab));
  }

  private void CloseCurrentPallet() => Dispatcher.Dispatch(new ResetPalletAction());
}
