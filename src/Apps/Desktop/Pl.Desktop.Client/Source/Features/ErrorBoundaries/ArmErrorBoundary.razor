@using Pl.Desktop.Client.Source.Shared.Constants

<UseParameterlessEndpoint Endpoint="@ArmEndpoints.ArmEndpoint" Context="query">
  @if (query is { HasData: false, IsLoading: false })
  {
    <div class="size-full flex items-center justify-center">
      <div class="flex max-w-sm flex-col items-center space-y-5">
        <HeroIcon Name="exclamation-triangle" Class="size-24 text-destructive" />
        <div class="flex flex-col text-center gap-2">
          <h2 class="text-xl font-semibold">@Localizer["ArmIsNewWarningTitle"]</h2>
          <p class="text-sm">
            @Localizer["ArmIsNewWarningDescription"]
          </p>
        </div>
        <div class="w-full max-w-xs mx-auto flex flex-col space-y-2">
          <PlButton OnClick="@query.Refetch" Variant="ButtonVariant.Outline" Class="w-full">
            <HeroIcon Name="arrow-path" Class="size-4 mr-2" />
            @Localizer["BtnUpdate"]
          </PlButton>
          <PlButton Link="@Routes.Home" Class="w-full">
            <HeroIcon Name="arrow-right-start-on-rectangle" Class="size-4 mr-2" />
            Главная страница
          </PlButton>
        </div>
      </div>
    </div>
  }
  else
  {
    @ChildContent
  }
</UseParameterlessEndpoint>


@code {
  # region Injects

  [Inject] private IStringLocalizer<ApplicationResources> Localizer { get; set; } = default!;
  [Inject] private ArmEndpoints ArmEndpoints { get; set; } = default!;

  # endregion

  [Parameter] public RenderFragment? ChildContent { get; set; }
}
