{
  "name": "palleto-ui-kit",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "format": "bunx biome format wwwroot/libs --write",
    "lint": "bunx biome lint wwwroot/libs/**/*.{ts} --write",
    "build:js": "node build-modules.mjs && esbuild wwwroot/ts/index.ts --bundle --minify --target=es2020 --outfile=wwwroot/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@tailwindcss/cli": "^4.3.0",
    "esbuild": "^0.27.7",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}