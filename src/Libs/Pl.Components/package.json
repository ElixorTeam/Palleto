{
  "name": "palleto-ui-kit",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "format": "bunx biome format wwwroot/libs --write",
    "lint": "bunx biome lint wwwroot/libs/**/*.{ts} --write",
    "build:modules": "node build-modules.mjs",
    "build:css": "bunx @tailwindcss/cli -i wwwroot/app.css -o wwwroot/app.min.css --minify",
    "build:js": "esbuild wwwroot/ts/index.ts --bundle --minify --target=es2020 --outfile=wwwroot/index.js",
    "build": "bun run build:js && bun run build:modules && bun run build:css"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@tailwindcss/cli": "^4.3.0",
    "esbuild": "^0.27.7",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}