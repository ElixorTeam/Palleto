<Project Sdk="Microsoft.NET.Sdk.Razor">
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup Label="Packages">
        <PackageReference Include="BlazorBlueprint.Icons.Heroicons" />
        <PackageReference Include="BlazorBlueprint.Primitives" />
        <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" VersionOverride="4.11.5" />
        <PackageReference Include="TailwindMerge.NET" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="wwwroot\ts\**\*" />
    </ItemGroup>

    <ItemGroup>
        <None Include="wwwroot\ts\**\*">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
    </ItemGroup>
</Project>