@namespace Pl.Components.Components
@inherits PlComponentBase
@* @inject IBbLocalizer Localizer *@
@* aria-label="@Localizer["Breadcrumb.Breadcrumb"]" *@


<nav class="@CssClass">
  <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
    @ChildContent
  </ol>
</nav>

@code {
  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  protected override string CssClass => ClassNames.Cn(Class);
}