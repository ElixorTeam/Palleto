@namespace Pl.Components
@inherits PlComponentBase

@if (List is { AutoSeparator: true } && _itemIndex > 1)
{
  <PlBreadcrumbSeparator>
    @List.SeparatorContent
  </PlBreadcrumbSeparator>
}
<li class="@CssClass">
  @ChildContent
</li>

@code {
  private int _itemIndex;

  [CascadingParameter]
  public PlBreadcrumbList? List { get; set; }

  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  protected override void OnInitialized()
  {
    if (List is { AutoSeparator: true })
    {
      _itemIndex = List.RegisterItem();
    }
  }

  private string CssClass => CssUtil.Cn("inline-flex items-center gap-1.5", Class);
}