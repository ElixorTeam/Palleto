@namespace Pl.Components.Components
@using BlazorBlueprint.Primitives.DropdownMenu
@inherits PlComponentBase

<BbDropdownMenuTrigger class="@CssClass"
  AsChild="@AsChild"
  Disabled="@Disabled"
  OnClick="@OnClick"
  CustomClickHandling="@CustomClickHandling"
  @attributes="AdditionalAttributes">
  @ChildContent
</BbDropdownMenuTrigger>

@code {
    [CascadingParameter]
    private DropdownMenuContext? Context { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// CSS classes applied when the dropdown is open.
    /// Default is <c>null</c> (no active style).
    /// Set to e.g. <c>"bg-accent text-accent-foreground"</c> to highlight the trigger when open.
    /// </summary>
    [Parameter]
    public string ActiveClass { get; set; } = string.Empty;

    /// <summary>
    /// When true, the trigger does not render its own button element.
    /// Instead, it passes trigger behavior via TriggerContext to child components.
    /// Use this when you want a custom component (like Button) to act as the trigger.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    /// <summary>
    /// Whether the trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Custom click handler.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Whether to use custom click handling only.
    /// </summary>
    [Parameter]
    public bool CustomClickHandling { get; set; }

    private bool IsOpen => Context?.IsOpen ?? false;

    private string CssClass => CssUtil.Cn(IsOpen ? ActiveClass : null, Class);
}