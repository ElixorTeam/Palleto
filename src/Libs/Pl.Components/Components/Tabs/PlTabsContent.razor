@using BlazorBlueprint.Primitives.Tabs
@namespace Pl.Components
@inherits PlComponentBase

<BbTabsContent
  Value="@Value"
  ForceMount="@ForceMount"
  class="@CssClass">
  @ChildContent
</BbTabsContent>

@code {
  /// <summary>
  /// The value that identifies this tab content panel.
  /// Must match the Value of the corresponding TabsTrigger.
  /// </summary>
  [Parameter, EditorRequired]
  public string Value { get; set; } = string.Empty;

  /// <summary>
  /// Whether to force mount the content even when inactive.
  /// </summary>
  [Parameter]
  public bool ForceMount { get; set; }

  /// <summary>
  /// The child content to render when this tab is active.
  /// </summary>
  [Parameter]
  public RenderFragment? ChildContent { get; set; }


  private string CssClass => CssUtil.Cn(
    "mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2",
    "focus-visible:ring-ring focus-visible:ring-offset-2",
    Class
  );
}