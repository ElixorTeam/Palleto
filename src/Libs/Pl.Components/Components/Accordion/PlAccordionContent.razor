@using BlazorBlueprint.Primitives.Accordion
@namespace Pl.Components
@inherits PlComponentBase

<BbAccordionContent ForceMount="true" class="@CssClass">
  <div class="overflow-hidden min-h-0">
    <div class="pb-4 pt-0 text-sm">
      @ChildContent
    </div>
  </div>
</BbAccordionContent>

@code {
  /// <summary>
  /// The child content to render when the item is open.
  /// </summary>
  [Parameter]
  public RenderFragment? ChildContent { get; set; }


  private string CssClass => CssUtil.Cn(
    "grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out",
    "data-[state=open]:grid-rows-[1fr]",
    Class
  );
}