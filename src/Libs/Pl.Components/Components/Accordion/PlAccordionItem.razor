@using BlazorBlueprint.Primitives.Accordion
@namespace Pl.Components.Components
@inherits PlComponentBase

<BbAccordionItem Value="@Value" Disabled="@Disabled" class="@CssClass">
  @ChildContent
</BbAccordionItem>

@code {
  /// <summary>
  /// The value that uniquely identifies this accordion item.
  /// </summary>
  [Parameter, EditorRequired]
  public string Value { get; set; } = string.Empty;

  /// <summary>
  /// Whether this accordion item is disabled.
  /// </summary>
  [Parameter]
  public bool Disabled { get; set; }

  /// <summary>
  /// The child content to render within the accordion item.
  /// </summary>
  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  private string CssClass => CssUtil.Cn("border-b", Class);
}