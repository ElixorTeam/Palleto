@namespace Pl.Components.Components
@using BlazorBlueprint.Primitives.Separator
@inherits PlComponentBase

<BlazorBlueprint.Primitives.Separator.BbSeparator
  Orientation="@MappedOrientation"
  Decorative="@Decorative"
  class="@CssClass" />

@code {
    /// <summary>
    /// Default value is False
    /// </summary>
    [Parameter]
    public bool Vertical { get; set; }

    /// <summary>
    /// Gets or sets whether the separator is purely decorative.
    /// </summary>
    /// <remarks>
    /// <para>
    /// When true (default), the separator is treated as decorative (role="none") and
    /// hidden from assistive technologies.
    /// </para>
    /// <para>
    /// When false, the separator is semantic (role="separator") and will be announced
    /// to screen readers, with the orientation specified via aria-orientation.
    /// </para>
    /// </remarks>
    [Parameter]
    public bool Decorative { get; set; } = true;


    /// <summary>
    /// Gets the computed CSS classes for the separator element.
    /// </summary>
    /// <remarks>
    /// Combines:
    /// - Base separator styles (shrink-0, bg-border)
    /// - Orientation-specific classes (width/height)
    /// - Custom classes from the Class parameter
    /// </remarks>
    protected override string CssClass => ClassNames.Cn(
        "shrink-0 bg-border",
        ClassNames.WhenElse(Vertical, "h-full w-[1px]", "h-[1px] w-full"),
        Class
    );

    private SeparatorOrientation MappedOrientation =>
      Vertical ? SeparatorOrientation.Vertical : SeparatorOrientation.Horizontal;
}