@namespace Pl.Components
@inherits PlComponentBase

<div class="@CssClass">
  @ChildContent
</div>

@code {
  /// <summary>
  /// Gets or sets the content to be rendered inside the label.
  /// </summary>
  [Parameter]
  public RenderFragment? ChildContent { get; set; }

  private string CssClass => CssUtil.Cn("py-1.5 px-2 text-sm font-semibold text-foreground", Class);
}