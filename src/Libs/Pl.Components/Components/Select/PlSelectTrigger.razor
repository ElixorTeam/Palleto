@typeparam TValue
@namespace Pl.Components
@using BlazorBlueprint.Primitives.Select
@inherits PlComponentBase

<BbSelectTrigger
  TValue="TValue"
  class="@CssClass"
  aria-invalid="@EffectiveAriaInvalid"
  @attributes="AdditionalAttributes">
  @ChildContent

  <HeroIcon
    Name="chevron-down"
    Class="@CssUtil.Cn(
      "pointer-events-none size-4 text-muted-foreground transition-transform duration-200",
      IsOpen ? "rotate-180" : "rotate-0")" />
</BbSelectTrigger>

@code {
  /// <summary>
  /// Cascading parameter to infer TValue from parent Select context.
  /// </summary>
  [CascadingParameter]
  private SelectContext<TValue>? Context { get; set; }

  [CascadingParameter(Name = "FieldIsInvalid")]
  private bool? FieldIsInvalid { get; set; }

  /// <summary>
  /// Gets or sets whether the trigger is in an invalid state.
  /// When null, falls back to the cascaded <c>FieldIsInvalid</c> value from <see cref="PlField"/>.
  /// </summary>
  [Parameter]
  public bool? AriaInvalid { get; set; }


  /// <summary>
  /// Gets or sets the content to be rendered inside the trigger button.
  /// </summary>
  [Parameter]
  public RenderFragment? ChildContent { get; set; }


  private bool IsOpen => Context?.IsOpen ?? false;

  private string? EffectiveAriaInvalid
  {
    get
    {
      if (AriaInvalid.HasValue)
        return AriaInvalid.Value ? "true" : "false";
      if (FieldIsInvalid == true)
        return "true";
      return null;
    }
  }

  /// <summary>
  /// Gets the computed CSS classes for the trigger button.
  /// </summary>
  private string CssClass => CssUtil.Cn(
    // Base trigger styles (from shadcn/ui v4)
    "flex h-9 w-full items-center justify-between gap-1.5 rounded-lg border border-input",
    "py-2 px-3 text-sm whitespace-nowrap transition-colors outline-none select-none",
    // Open state
    IsOpen ? "bg-accent text-accent-foreground" : "bg-transparent",
    // Focus states
    "focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50",
    // Error states (aria-invalid)
    "aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20",
    // Disabled state
    "disabled:cursor-not-allowed disabled:opacity-50",
    // Dark mode
    IsOpen ? null : "dark:bg-input/30 dark:hover:bg-input/50",
    "dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40",
    Class
  );
}