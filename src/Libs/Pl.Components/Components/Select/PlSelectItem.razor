@typeparam TValue
@namespace Pl.Components
@using BlazorBlueprint.Primitives.Select
@inherits PlComponentBase
@implements IDisposable

<BbSelectItem
  class="@CssClass"
  TValue="TValue"
  Value="Value"
  Text="@GetDisplayText()"
  Disabled="Disabled">
  <span class="truncate">
    @if (ChildContent is not null)
    {
      @ChildContent
    }
    else
    {
      @GetDisplayText()
    }
  </span>
  @if (IsSelected)
  {
    <HeroIcon
      Name="check"
      Class="ml-auto size-4 shrink-0" />
  }
</BbSelectItem>

@code {
    [CascadingParameter]
    private SelectContext<TValue>? Context { get; set; }

    private bool _lastIsSelected;
    private bool _lastDisabled;

    /// <summary>
    /// Gets or sets the value of this item.
    /// </summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>
    /// Gets or sets the display text for this item.
    /// If not provided, will use ChildContent text or Value.ToString().
    /// </summary>
    [Parameter]
    public string? Text { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the content to be rendered as the item's display text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether this item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets whether this item is currently selected.
    /// </summary>
    private bool IsSelected => Context != null && EqualityComparer<TValue?>.Default.Equals(Context.Value, Value);

    /// <summary>
    /// Gets the display text for this item.
    /// Uses Text parameter if provided, otherwise falls back to Value.ToString().
    /// </summary>
    private string? GetDisplayText() =>
      Text ?? Value?.ToString();

    /// <summary>
    /// Gets the computed CSS classes for the item.
    /// </summary>
    private string CssClass => CssUtil.Cn(
      // Base item styles (from shadcn/ui v4)
      "relative flex w-full cursor-default items-center gap-1.5 rounded-md py-1.5 px-2 text-sm",
      "outline-hidden select-none transition-colors",
      // Focus states
      "data-[focused=true]:bg-accent data-[focused=true]:text-accent-foreground",
      // Disabled state
      "data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50",
      Class
    );

    protected override void OnInitialized()
    {
        if (Context != null)
        {
            Context.OnStateChanged += HandleStateChanged;
        }

        _lastIsSelected = IsSelected;
        _lastDisabled = Disabled;
    }

    protected override bool ShouldRender()
    {
        bool currentIsSelected = IsSelected;

        if (currentIsSelected == _lastIsSelected &&
            Disabled == _lastDisabled)
          return false;
        _lastIsSelected = currentIsSelected;
        _lastDisabled = Disabled;
        return true;

    }

    private void HandleStateChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (Context != null)
        {
            Context.OnStateChanged -= HandleStateChanged;
        }
    }
}