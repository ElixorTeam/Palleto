@namespace Pl.Components
@inherits PlComponentBase

<div
  @attributes="AdditionalAttributes"
  class="@CssClass">
  @ChildContent
</div>

@code {
    /// <summary>
    /// Default value is <see cref="BadgeVariant.Default"/>.
    /// </summary>
    [Parameter]
    public BadgeVariant Variant { get; set; } = BadgeVariant.Default;

    /// <summary>
    /// Gets or sets the content to be rendered inside the badge.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string CssClass => CssUtil.Cn(
        "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold",
        "transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 select-none",
        Variant.GetCss(),
        Class
    );
}