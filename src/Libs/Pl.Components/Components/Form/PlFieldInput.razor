@namespace Pl.Components
@using System.Linq.Expressions
@inherits FieldBase

<PlField Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class">
  @if (!string.IsNullOrEmpty(Label))
  {
    <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
  }
  <PlFieldContent>
    <PlInput
      Id="@ControlId"
      Value="@Value"
      ValueChanged="HandleValueChanged"
      ValueExpression="@ValueExpression"
      Name="@Name"
      Type="@Type"
      Placeholder="@Placeholder"
      Disabled="@Disabled"
      Required="@Required"
      JsSyncTiming="@JsSyncTiming"
      DebounceInterval="@DebounceInterval"
      AriaLabel="@AriaLabel"
      AriaDescribedBy="@DescribedById"
      AriaInvalid="@IsInvalid"
      Class="@InputClass"
      />
    @if (!string.IsNullOrEmpty(HelperText) && !IsInvalid)
    {
      <PlFieldDescription Id="@DescriptionId">@HelperText</PlFieldDescription>
    }
    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
      <PlFieldError Id="@ErrorId">@ErrorText</PlFieldError>
    }
    else if (HasEditContextErrors)
    {
      <PlFieldError Id="@ErrorId" Errors="@EditContextErrors" />
    }
  </PlFieldContent>
</PlField>

@code {
    /// <summary>
    /// Gets or sets whether the checkbox is checked.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that Identifies the bound value for EditForm integration.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the HTML name attribute. Passed through to the inner input.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets whether the input is required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Default value is <see cref="InputType.Text"/>.
    /// </summary>
    [Parameter]
    public InputType Type { get; set; } = InputType.Text;

    /// <summary>
    /// Default value is <see cref="JsSyncTiming.OnBlur"/>.
    /// </summary>
    [Parameter]
    public JsSyncTiming JsSyncTiming { get; set; } = JsSyncTiming.OnBlur;

    /// <summary>
    /// Gets or sets the debounced delay in milliseconds.
    /// </summary>
    [Parameter]
    public int DebounceInterval { get; set; } = 500;

    /// <summary>
    /// Gets or sets whether the input is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes applied to the inner NumericInput element.
    /// </summary>
    [Parameter]
    public string? InputClass { get; set; }

    /// <inheritdoc />
    protected override LambdaExpression? GetFieldExpression() => ValueExpression;

    private async Task HandleValueChanged(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        NotifyFieldChanged();
    }
}
