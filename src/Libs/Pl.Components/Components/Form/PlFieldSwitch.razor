@using System.Linq.Expressions
@namespace Pl.Components
@inherits FieldBase

<PlSwitch Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class">
  @if (!string.IsNullOrEmpty(Label))
  {
    <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
  }
  <PlFieldContent>
    <PlSwitch
      Id="@ControlId"
      Value="@Value"
      ValueChanged="HandleValueChanged"
      ValueExpression="@ValueExpression"
      Size="@Size"
      Disabled="@Disabled"
      AriaLabel="@AriaLabel"
      AriaDescribedBy="@DescribedById"
      Class="@InputClass" />
    @if (!string.IsNullOrEmpty(HelperText) && !IsInvalid)
    {
      <PlFieldDescription Id="@DescriptionId">@HelperText</PlFieldDescription>
    }
    @if (!string.IsNullOrEmpty(ErrorText) && IsInvalid)
    {
      <PlFieldError Id="@ErrorId">@ErrorText</PlFieldError>
    }
    else if (HasEditContextErrors)
    {
      <PlFieldError Id="@ErrorId" Errors="@EditContextErrors" />
    }
  </PlFieldContent>
</PlSwitch>

@code {
    /// <summary>
    /// Gets or sets whether the switch is checked (on).
    /// </summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that identifies the bound value for EditForm integration.
    /// </summary>
    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the size variant of the switch.
    /// </summary>
    [Parameter]
    public SwitchSize Size { get; set; } = SwitchSize.Medium;

    /// <summary>
    /// Gets or sets whether the switch is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes applied to the inner Switch element.
    /// </summary>
    [Parameter]
    public string InputClass { get; set; } = string.Empty;

    /// <inheritdoc />
    protected override LambdaExpression? GetFieldExpression() => ValueExpression;

    private async Task HandleValueChanged(bool value)
    {
      Value = value;
      await ValueChanged.InvokeAsync(value);
      NotifyFieldChanged();
    }
}