@namespace Pl.Components.Components
@using System.Linq.Expressions
@inherits FieldBase

<PlField Orientation="@EffectiveOrientation" IsInvalid="@IsInvalid" Class="@Class">
  @if (!string.IsNullOrEmpty(Label) && Orientation is FieldOrientation.Vertical)
  {
    <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
  }
  <PlFieldContent>
    @if (Orientation is FieldOrientation.HorizontalEnd or FieldOrientation.Horizontal)
    {
      <div class="flex items-center gap-2">
        @if (Orientation is FieldOrientation.Horizontal && string.IsNullOrEmpty(Label))
        {
          <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
        }
        <PlCheckbox
          Id="@ControlId"
          Value="@Value"
          ValueChanged="HandleValueChanged"
          CheckedExpression="@ValueExpression"
          Indeterminate="@Indeterminate"
          IndeterminateChanged="@IndeterminateChanged"
          Disabled="@Disabled"
          Required="@Required"
          AriaLabel="@AriaLabel"
          AriaDescribedBy="@DescribedById"
          Class="@InputClass" />
        @if (Orientation is FieldOrientation.HorizontalEnd && string.IsNullOrEmpty(Label))
        {
          <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
        }
      </div>
    }
    else
    {
      <PlCheckbox
        Id="@ControlId"
        Value="@Value"
        ValueChanged="@HandleValueChanged"
        CheckedExpression="@ValueExpression"
        Indeterminate="@Indeterminate"
        IndeterminateChanged="@IndeterminateChanged"
        Disabled="@Disabled"
        Required="@Required"
        AriaLabel="@AriaLabel"
        AriaDescribedBy="@DescribedById"
        Class="@InputClass" />
      @if (string.IsNullOrEmpty(Label) && Orientation is FieldOrientation.VerticalEnd)
      {
        <PlFieldLabel For="@ControlId">@Label</PlFieldLabel>
      }
    }
    @if (!string.IsNullOrEmpty(HelperText) && !IsInvalid)
    {
      <PlFieldDescription Pl="@DescriptionId">@HelperText</PlFieldDescription>
    }
    @if (!string.IsNullOrEmpty(ErrorText) && IsInvalid)
    {
      <PlFieldError Id="@ErrorId">@ErrorText</PlFieldError>
    }
    else if (HasEditContextErrors)
    {
      <PlFieldError Id="@ErrorId" Errors="@EditContextErrors" />
    }
  </PlFieldContent>
</PlField>

@code {
      /// <summary>
    /// Gets or sets whether the checkbox is checked.
    /// </summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets an expression that Identifies the bound value for EditForm integration.
    /// </summary>
    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is in an indeterminate state.
    /// </summary>
    [Parameter]
    public bool Indeterminate { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the indeterminate state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IndeterminateChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is required in a form context.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes applied to the inner Checkbox element.
    /// </summary>
    [Parameter]
    public string InputClass { get; set; } = string.Empty;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (!parameters.TryGetValue<FieldOrientation>(nameof(Orientation), out _))
            Orientation = FieldOrientation.HorizontalEnd;
        return base.SetParametersAsync(parameters);
    }

    /// <inheritdoc />
    protected override LambdaExpression? GetFieldExpression() => ValueExpression;

    private FieldOrientation EffectiveOrientation =>
      Orientation is FieldOrientation.HorizontalEnd or FieldOrientation.Horizontal or FieldOrientation.VerticalEnd
        ? FieldOrientation.Vertical : Orientation;

    private async Task HandleValueChanged(bool value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        NotifyFieldChanged();
    }
}