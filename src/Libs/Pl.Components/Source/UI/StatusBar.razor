@inherits PlComponentBase

<div class="@ClassMerge("h-2 w-full overflow-hidden rounded-full bg-primary/20", Class)">
  <div class="size-full flex-1 bg-primary transition-transform ease-in-out duration-500" style="@($"transform: translateX(-{100 - Value}%);")"></div>
</div>

@code {
  [Parameter] public int Value { get; set; }
}